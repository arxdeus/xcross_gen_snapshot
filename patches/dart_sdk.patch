+// SUCH DAMAGE.
+
+#ifndef RUNTIME_PLATFORM_XCROSS_APPLE_SORT_H_
+#define RUNTIME_PLATFORM_XCROSS_APPLE_SORT_H_
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+namespace dart {
+namespace xcross_sort {
+
+typedef int CompareFn(const void*, const void*);
+
+inline int Fls(uint64_t x) {
+  int r = 0;
+  while (x != 0) {
+    r++;
+    x >>= 1;
+  }
+  return r;
+}
+
+// Swaps n bytes at pi and pj in units of TYPE. The units are copied
+// through locals with memcpy (no type-punned lvalues), which compilers
+// lower to plain loads and stores.
+template <typename TYPE>
+inline void SwapCode(char* pi, char* pj, size_t n) {
+  size_t i = n / sizeof(TYPE);
+  do {
+    TYPE ti;
+    TYPE tj;
+    memcpy(&ti, pi, sizeof(TYPE));
+    memcpy(&tj, pj, sizeof(TYPE));
+    memcpy(pi, &tj, sizeof(TYPE));
+    memcpy(pj, &ti, sizeof(TYPE));
+    pi += sizeof(TYPE);
+    pj += sizeof(TYPE);
+  } while (--i > 0);
+}
+
+inline int SwapType(const void* a, size_t es, size_t size) {
+  return (reinterpret_cast<uintptr_t>(a) % size != 0 || es % size != 0)
+             ? 2
+             : (es == size ? 0 : 1);
+}
+
+inline void SwapFunc(char* a,
+                     char* b,
+                     size_t n,
+                     int swaptype_long,
+                     int swaptype_int) {
+  if (swaptype_long <= 1) {
+    SwapCode<int64_t>(a, b, n);
+  } else if (swaptype_int <= 1) {
+    SwapCode<int32_t>(a, b, n);
+  } else {
+    SwapCode<char>(a, b, n);
+  }
+}
+
+inline void Swap(char* a,
+                 char* b,
+                 size_t es,
+                 int swaptype_long,
+                 int swaptype_int) {
+  if (swaptype_long == 0) {
+    SwapCode<int64_t>(a, b, sizeof(int64_t));
+  } else if (swaptype_int == 0) {
+    SwapCode<int32_t>(a, b, sizeof(int32_t));
+  } else {
+    SwapFunc(a, b, es, swaptype_long, swaptype_int);
+  }
+}
+
+inline char* Med3(char* a, char* b, char* c, CompareFn* cmp) {
+  return cmp(a, b) < 0 ? (cmp(b, c) < 0 ? b : (cmp(a, c) < 0 ? c : a))
+                       : (cmp(b, c) > 0 ? b : (cmp(a, c) < 0 ? a : c));
+}
+
+inline bool InsertionSort(void* a,
+                          size_t n,
+                          size_t es,
+                          CompareFn* cmp,
+                          int swap_limit,
+                          int swaptype_long,
+                          int swaptype_int) {
+  int swap_cnt = 0;
+  for (char* pm = static_cast<char*>(a) + es;
+       pm < static_cast<char*>(a) + n * es; pm += es) {
+    for (char* pl = pm; pl > static_cast<char*>(a) && cmp(pl - es, pl) > 0;
+         pl -= es) {
+      Swap(pl, pl - es, es, swaptype_long, swaptype_int);
+      if (swap_limit && ++swap_cnt > swap_limit) return false;
+    }
+  }
+  return true;
+}
+
+#define XCROSS_HSWAP(a, b, count, size, tmp)                                   \
+  {                                                                            \
+    count = size;                                                              \
+    do {                                                                       \
+      tmp = *a;                                                                \
+      *a++ = *b;                                                               \
+      *b++ = tmp;                                                              \
+    } while (--count);                                                         \
+  }
+
+#define XCROSS_HCOPY(a, b, count, size, tmp1, tmp2)                            \
+  {                                                                            \
+    count = size;                                                              \
+    tmp1 = a;                                                                  \
+    tmp2 = b;                                                                  \
+    do {                                                                       \
+      *tmp1++ = *tmp2++;                                                       \
+    } while (--count);                                                         \
+  }
+
+#define XCROSS_HCREATE(initval, nmemb, par_i, child_i, par, child, size, count, \
+                       tmp)                                                    \
+  {                                                                            \
+    for (par_i = initval; (child_i = par_i * 2) <= nmemb; par_i = child_i) {   \
+      child = base + child_i * size;                                           \
+      if (child_i < nmemb && compar(child, child + size) < 0) {                \
+        child += size;                                                         \
+        ++child_i;                                                             \
+      }                                                                        \
+      par = base + par_i * size;                                               \
+      if (compar(child, par) <= 0) break;                                      \
+      XCROSS_HSWAP(par, child, count, size, tmp);                              \
+    }                                                                          \
+  }
+
+#define XCROSS_HSELECT(par_i, child_i, nmemb, par, child, size, k, count,      \
+                       tmp1, tmp2)                                             \
+  {                                                                            \
+    for (par_i = 1; (child_i = par_i * 2) <= nmemb; par_i = child_i) {         \
+      child = base + child_i * size;                                           \
+      if (child_i < nmemb && compar(child, child + size) < 0) {                \
+        child += size;                                                         \
+        ++child_i;                                                             \
+      }                                                                        \
+      par = base + par_i * size;                                               \
+      XCROSS_HCOPY(par, child, count, size, tmp1, tmp2);                       \
+    }                                                                          \
+    for (;;) {                                                                 \
+      child_i = par_i;                                                         \
+      par_i = child_i / 2;                                                     \
+      child = base + child_i * size;                                           \
+      par = base + par_i * size;                                               \
+      if (child_i == 1 || compar(k, par) < 0) {                                \
+        XCROSS_HCOPY(child, k, count, size, tmp1, tmp2);                       \
+        break;                                                                 \
+      }                                                                        \
+      XCROSS_HCOPY(child, par, count, size, tmp1, tmp2);                       \
+    }                                                                          \
+  }
+
+inline int HeapSort(void* vbase, size_t nmemb, size_t size, CompareFn* compar) {
+  size_t cnt, i, j, l;
+  char tmp, *tmp1, *tmp2;
+  char *base, *k, *p, *t;
+
+  if (nmemb <= 1) return 0;
+  if (!size) return -1;
+  k = static_cast<char*>(malloc(size));
+  if (k == nullptr) return -1;
+  base = static_cast<char*>(vbase) - size;
+  for (l = nmemb / 2 + 1; --l;)
+    XCROSS_HCREATE(l, nmemb, i, j, t, p, size, cnt, tmp);
+  while (nmemb > 1) {
+    XCROSS_HCOPY(k, base + nmemb * size, cnt, size, tmp1, tmp2);
+    XCROSS_HCOPY(base + nmemb * size, base + size, cnt, size, tmp1, tmp2);
+    --nmemb;
+    XCROSS_HSELECT(i, j, nmemb, t, p, size, k, cnt, tmp1, tmp2);
+  }
+  free(k);
+  return 0;
+}
+
+#define XCROSS_MIN(a, b) ((a) < (b) ? a : b)
+
+inline void QSortImpl(void* a,
+                      size_t n,
+                      size_t es,
+                      CompareFn* cmp,
+                      int depth_limit) {
+  char *pa, *pb, *pc, *pd, *pl, *pm, *pn;
+  size_t d1, d2;
+  int cmp_result;
+  int swaptype_long, swaptype_int, swap_cnt;
+
+loop:
+  swaptype_long = SwapType(a, es, sizeof(int64_t));
+  swaptype_int = SwapType(a, es, sizeof(int32_t));
+  swap_cnt = 0;
+
+  if (depth_limit-- <= 0) {
+    HeapSort(a, n, es, cmp);
+    return;
+  }
+
+  if (n <= 7) {
+    InsertionSort(a, n, es, cmp, 0, swaptype_long, swaptype_int);
+    return;
+  }
+
+  pl = static_cast<char*>(a);
+  pm = static_cast<char*>(a) + (n / 2) * es;
+  pn = static_cast<char*>(a) + (n - 1) * es;
+  if (n > 40) {
+    size_t d = (n / 8) * es;
+    pl = Med3(pl, pl + d, pl + 2 * d, cmp);
+    pm = Med3(pm - d, pm, pm + d, cmp);
+    pn = Med3(pn - 2 * d, pn - d, pn, cmp);
+  }
+  pm = Med3(pl, pm, pn, cmp);
+
+  Swap(static_cast<char*>(a), pm, es, swaptype_long, swaptype_int);
+  pa = pb = static_cast<char*>(a) + es;
+  pc = pd = static_cast<char*>(a) + (n - 1) * es;
+
+  for (;;) {
+    while (pb <= pc && (cmp_result = cmp(pb, a)) <= 0) {
+      if (cmp_result == 0) {
+        swap_cnt = 1;
+        Swap(pa, pb, es, swaptype_long, swaptype_int);
+        pa += es;
+      }
+      pb += es;
+    }
+    while (pb <= pc && (cmp_result = cmp(pc, a)) >= 0) {
+      if (cmp_result == 0) {
+        swap_cnt = 1;
+        Swap(pc, pd, es, swaptype_long, swaptype_int);
+        pd -= es;
+      }
+      pc -= es;
+    }
+    if (pb > pc) break;
+    Swap(pb, pc, es, swaptype_long, swaptype_int);
+    swap_cnt = 1;
+    pb += es;
+    pc -= es;
+  }
+
+  pn = static_cast<char*>(a) + n * es;
+  d1 = XCROSS_MIN(static_cast<size_t>(pa - static_cast<char*>(a)),
+                  static_cast<size_t>(pb - pa));
+  if (d1 > 0) SwapFunc(static_cast<char*>(a), pb - d1, d1, swaptype_long,
+                       swaptype_int);
+  d1 = XCROSS_MIN(static_cast<size_t>(pd - pc),
+                  static_cast<size_t>(pn - pd) - es);
+  if (d1 > 0) SwapFunc(pb, pn - d1, d1, swaptype_long, swaptype_int);
+
+  if (swap_cnt == 0) {
+    int r = 1 + static_cast<int>(n / 4);
+    if (!InsertionSort(a, n, es, cmp, r, swaptype_long, swaptype_int)) {
+      goto nevermind;
+    }
+    return;
+  }
+nevermind:
+
+  d1 = pb - pa;
+  d2 = pd - pc;
+  if (d1 <= d2) {
+    if (d1 > es) {
+      QSortImpl(a, d1 / es, es, cmp, depth_limit);
+    }
+    if (d2 > es) {
+      a = pn - d2;
+      n = d2 / es;
+      goto loop;
+    }
+  } else {
+    if (d2 > es) {
+      QSortImpl(pn - d2, d2 / es, es, cmp, depth_limit);
+    }
+    if (d1 > es) {
+      n = d1 / es;
+      goto loop;
+    }
+  }
+}
+
+inline void QSort(void* a, size_t n, size_t es, CompareFn* cmp) {
+  QSortImpl(a, n, es, cmp, 2 * (Fls(static_cast<uint64_t>(n)) - 1));
+}
+
+#undef XCROSS_MIN
+#undef XCROSS_HSELECT
+#undef XCROSS_HCREATE
+#undef XCROSS_HCOPY
+#undef XCROSS_HSWAP
+
+}  // namespace xcross_sort
+}  // namespace dart
+
+#endif  // RUNTIME_PLATFORM_XCROSS_APPLE_SORT_H_
